{
  "name": "copycat",
  "private": true,
  "version": "1.0.0",
  "description": "AI-driven macro recording & playback companion for Daffodil Intelligence",
  "author": "Daffodil Intelligence Team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-shoaib2/daffodil-intelligence.git"
  },
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"vite --port 3001\" \"wait-on http://localhost:3001 && electron .\"",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:start": "electron .",
    "pack": "pnpm build && electron-packager . copycat --platform=win32 --arch=x64 --out=release-builds --overwrite --no-prune",
    "postinstall": "node postinstall.js"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.2",
    "electron": "39.8.10",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.61.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  }
}
