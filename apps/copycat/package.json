{
  "name": "copycat",
  "private": true,
  "version": "1.0.0",
  "description": "AI-driven macro recording & playback companion for Daffodil Intelligence",
  "author": "Daffodil Intelligence Team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-shoaib2/daffodil-intelligence.git"
  },
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"vite --port 3001\" \"wait-on http://localhost:3001 && electron .\"",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:start": "electron .",
    "pack": "pnpm build && electron-packager . copycat --platform=win32 --arch=x64 --out=release-builds --overwrite --no-prune",
    "postinstall": "node postinstall.js"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^8.2.2",
    "electron": "30.5.1",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.21",
    "wait-on": "^7.2.0"
  }
}
