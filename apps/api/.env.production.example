# =============================================================================
# Daffodil API — PRODUCTION
# Copy:  cp .env.production.example .env
# Sync secrets with repo root `.env` when using Docker Compose.
# =============================================================================

APP_NAME=Daffodil Intelligence API
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32

# --- Database ----------------------------------------------------------------
POSTGRES_USER=daffodil
POSTGRES_PASSWORD=CHANGE_ME_strong_postgres_password
POSTGRES_DB=daffodil
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://daffodil:CHANGE_ME_strong_postgres_password@postgres:5432/daffodil

# --- Redis -------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- MinIO -------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=daffodil
MINIO_SECRET_KEY=CHANGE_ME_strong_minio_password
MINIO_BUCKET=daffodil
MINIO_USE_SSL=false
MINIO_CONSOLE_URL=https://minio.your-domain.com

# --- Public URLs -------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_URL=https://api.your-domain.com
FRONTEND_PUBLIC_URL=https://your-domain.com
CORS_ORIGINS=https://your-domain.com

# --- Auth / JWT --------------------------------------------------------------
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# --- AI providers ------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_FAST_CHAT=true
HUGGINGFACE_API_KEY=
HUGGINGFACE_ENABLED=false
GEMINI_MODEL_NAME=gemini-2.0-flash
GEMINI_VOICE=Aoede
ANTIGRAVITY_MODEL=gemini-2.0-flash
ANTIGRAVITY_ENABLE_SUBAGENTS=true
USE_MOCK_DATA=false

# --- OAuth -------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.your-domain.com/api/auth/telegram/google/callback
TELEGRAM_GOOGLE_OAUTH_REDIRECT_URI=https://api.your-domain.com/api/auth/telegram/google/callback

# --- Email -------------------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=
SMTP_FROM=noreply@your-domain.com

# --- Telegram ----------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_OAUTH_PUBLIC_URL=https://api.your-domain.com

# --- Vector / memory ---------------------------------------------------------
QDRANT_URL=http://qdrant:6333
EMBEDDING_MODEL=text-embedding-3-small
MEMORY_QDRANT_COLLECTION=daffodil_memory
MEMORY_SEMANTIC_ENABLED=true

# --- MCP / Celery ------------------------------------------------------------
MCP_ENABLED=true
MCP_SERVER_PORT=8001
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Computer use ------------------------------------------------------------
COMPUTER_USE_ENABLED=true
COMPUTER_USE_REQUIRE_CONFIRM=true
SCREEN_CAPTURE_FPS=5

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=INFO

# --- University APIs (optional) ----------------------------------------------
UNIV_SIS_API_URL=https://sis.daffodiluniversity.edu.bd/api
UNIV_SIS_API_KEY=
UNIV_LIBRARY_API_URL=https://library.daffodiluniversity.edu.bd/api
UNIV_LIBRARY_API_KEY=
