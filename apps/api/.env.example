# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/daffodil
REDIS_URL=redis://localhost:6379

# AI API Keys
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# JWT Configuration
JWT_SECRET=your_secure_jwt_secret_key_min_32_characters
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=30

# OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
APPLE_CLIENT_ID=your_apple_client_id
APPLE_CLIENT_SECRET=your_apple_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Messaging
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
WHATSAPP_PHONE_ID=your_whatsapp_phone_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token

# AI Settings
GEMINI_MODEL_NAME=gemini-2.0-flash-exp
GEMINI_VOICE=Aoede

# Vector Database
QDRANT_URL=http://localhost:6333
EMBEDDING_MODEL=text-embedding-3-small

# CORS (comma-separated list of origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Environment
NODE_ENV=development
LOG_LEVEL=DEBUG
USE_MOCK_DATA=true

# University APIs
UNIV_SIS_API_URL=https://sis.daffodiluniversity.edu.bd/api
UNIV_SIS_API_KEY=your_sis_api_key
UNIV_LIBRARY_API_URL=https://library.daffodiluniversity.edu.bd/api
UNIV_LIBRARY_API_KEY=your_library_api_key
UNIV_HR_API_URL=https://hr.daffodiluniversity.edu.bd/api
UNIV_HR_API_KEY=your_hr_api_key
UNIV_TRANSPORT_API_URL=https://transport.daffodiluniversity.edu.bd/api
UNIV_TRANSPORT_API_KEY=your_transport_api_key
UNIV_EXAM_API_URL=https://exam.daffodiluniversity.edu.bd/api
UNIV_EXAM_API_KEY=your_exam_api_key