# =============================================================================
# Daffodil API — local environment
# Copy:  cp .env.example .env
# Keep Postgres / Redis / MinIO values in sync with the repo root `.env`.
# =============================================================================

APP_NAME=Daffodil Intelligence API
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=dev-secret-key-change-in-production

# --- Database (PostgreSQL) ---------------------------------------------------
# Host dev: localhost  |  Docker Compose API container: postgres
POSTGRES_USER=daffodil
POSTGRES_PASSWORD=daffodil
POSTGRES_DB=daffodil
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://daffodil:daffodil@localhost:5432/daffodil

# --- Redis -------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- MinIO (object storage) --------------------------------------------------
# API: http://localhost:9000  |  Console: http://localhost:9001
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=daffodil
MINIO_SECRET_KEY=daffodil123
MINIO_BUCKET=daffodil
MINIO_USE_SSL=false
MINIO_CONSOLE_URL=http://localhost:9001

# --- API server --------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Auth / JWT --------------------------------------------------------------
JWT_SECRET=your_secure_jwt_secret_key_min_32_characters
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=30

# --- AI providers ------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_NAME=gpt-4-turbo-preview
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_FAST_CHAT=true
HUGGINGFACE_API_KEY=
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
HUGGINGFACE_MODEL=zai-org/GLM-5.1
HUGGINGFACE_ENABLED=true
HUGGINGFACE_MAX_TOKENS=4096
HUGGINGFACE_TIMEOUT_SEC=180
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ANTIGRAVITY_MODEL=gemini-2.0-flash
ANTIGRAVITY_SAVE_DIR=conversations
ANTIGRAVITY_ENABLE_SUBAGENTS=true
GEMINI_MODEL_NAME=gemini-2.0-flash-exp
GEMINI_VOICE=Aoede
USE_MOCK_DATA=true

# --- OAuth -------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Web + Telegram Google sign-in (one URI in Google Cloud → Authorized redirect URIs)
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/telegram/google/callback
TELEGRAM_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/telegram/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Telegram ----------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# Telegram user ids allowed to run /shell (comma-separated; empty = nobody)
TELEGRAM_ADMIN_USER_IDS=
# Telegram chat model; "auto" uses the router (recommended)
TELEGRAM_CHAT_MODEL=auto
TELEGRAM_OAUTH_PUBLIC_URL=

# --- Email OTP ---------------------------------------------------------------
EMAIL_PROVIDER=auto
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@daffodil.local
SMTP_USE_SSL=false
SMTP_STARTTLS=false
RESEND_API_KEY=

# --- Messaging ---------------------------------------------------------------
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Vector / memory ---------------------------------------------------------
QDRANT_URL=http://localhost:6333
EMBEDDING_MODEL=text-embedding-3-small
MEMORY_QDRANT_COLLECTION=daffodil_memory
MEMORY_SEMANTIC_ENABLED=true

# --- MCP ---------------------------------------------------------------------
MCP_ENABLED=true
MCP_SERVER_PORT=8001
MCP_TRANSPORT=stdio
MCP_EXTERNAL_SERVERS=

# --- Celery ------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Computer use ------------------------------------------------------------
COMPUTER_USE_ENABLED=true
COMPUTER_USE_REQUIRE_CONFIRM=true
SCREEN_CAPTURE_FPS=5

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=INFO

# --- University APIs ---------------------------------------------------------
UNIV_SIS_API_URL=https://sis.daffodiluniversity.edu.bd/api
UNIV_SIS_API_KEY=
UNIV_LIBRARY_API_URL=https://library.daffodiluniversity.edu.bd/api
UNIV_LIBRARY_API_KEY=
UNIV_HR_API_URL=https://hr.daffodiluniversity.edu.bd/api
UNIV_HR_API_KEY=
UNIV_TRANSPORT_API_URL=https://transport.daffodiluniversity.edu.bd/api
UNIV_TRANSPORT_API_KEY=
UNIV_EXAM_API_URL=https://exam.daffodiluniversity.edu.bd/api
UNIV_EXAM_API_KEY=
