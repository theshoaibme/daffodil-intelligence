/**
 * Regenerate defaultCanvasLayout.ts from graphBuilder.computeDefaultPositions.
 * Run: npx tsx scripts/generate-default-layout.mts
 */
import { writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { computeDefaultPositions } from "../src/components/features/AgentDashboard/graphBuilder.ts";

const categories: Record<string, string> = {
  academic: "university",
  library: "university",
  campus: "university",
  career: "university",
  wellness: "university",
  finance: "university",
  exam: "university",
  hostel: "university",
  transport: "university",
  campus_events: "university",
  complaint: "university",
  fee: "university",
  routine: "university",
  coding: "productivity",
  research: "productivity",
  writing: "productivity",
  tasks: "productivity",
  event: "general",
  automation: "general",
  vision: "ai",
  voice: "ai",
  computer_use: "computer",
  copycat: "computer",
  planning: "orchestration",
  general: "general",
};

const agents = Object.keys(categories).map((id) => ({
  id,
  name: id,
  category: categories[id],
  status: "idle" as const,
  tasksCompleted: 0,
}));

const positions = computeDefaultPositions(agents);
const outPath = join(
  dirname(fileURLToPath(import.meta.url)),
  "../src/components/features/AgentDashboard/defaultCanvasLayout.ts"
);

const body = `/** Auto-generated by scripts/generate-default-layout.mts — do not edit by hand. */
import type { SavedPositions } from "./flowLayout";

export const DEFAULT_CANVAS_LAYOUT: SavedPositions = ${JSON.stringify(positions, null, 2)} as SavedPositions;
`;

writeFileSync(outPath, body, "utf8");
console.log(`Wrote ${outPath} (${Object.keys(positions).length} nodes)`);
