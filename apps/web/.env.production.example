# =============================================================================
# Daffodil Web — PRODUCTION (Vite build-time variables)
# Copy:  cp .env.production.example .env.production
# Build:  pnpm --filter daffodil-web build
# Values are baked into the static bundle at build time.
# =============================================================================

VITE_API_URL=https://api.your-domain.com
VITE_WS_URL=wss://api.your-domain.com

# Optional
# VITE_GOOGLE_CLIENT_ID=
# VITE_COPYCAT_URL=https://copycat.your-domain.com
