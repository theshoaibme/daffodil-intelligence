{
  "name": "daffodil-intelligence",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm docker:infra && turbo dev --ui=tui",
    "dev:api": "pnpm docker:infra && pnpm --filter daffodil-api dev",
    "dev:web": "pnpm --filter daffodil-web dev",
    "dev:stack": "pnpm docker:infra && turbo dev --ui=tui",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "docker:up": "docker compose up -d",
    "docker:infra": "docker compose up -d postgres redis minio adminer qdrant",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps"
  },
  "devDependencies": {
    "run-script-os": "^1.1.6",
    "turbo": "^2.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}