{
  "name": "daffodil-intelligence",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
   "dev": "turbo dev --ui=tui",
    "dev:web": "cd apps/web && npm run dev",
    "dev:api": "cd apps/api && python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "dev:mcp": "cd apps/mcp && python3 app/server.py",
    "dev:live": "cd apps/live && python3 app/server.py",
    "dev:messaging": "cd apps/messaging && python3 app/main.py",
    "dev:worker": "cd apps/worker && celery -A app.tasks worker --loglevel=info",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}