# =============================================================================
# Daffodil Intelligence — PRODUCTION (root / Docker Compose)
# Copy:  cp .env.production.example .env
# Replace every CHANGE_ME and your-domain.com before deploy.
# Never commit the real .env file.
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=daffodil
POSTGRES_PASSWORD=CHANGE_ME_strong_postgres_password
POSTGRES_DB=daffodil
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://daffodil:CHANGE_ME_strong_postgres_password@postgres:5432/daffodil

# --- Redis -------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- MinIO / S3-compatible storage -------------------------------------------
MINIO_ROOT_USER=daffodil
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://minio:9000
MINIO_CONSOLE_URL=https://minio.your-domain.com
MINIO_BUCKET=daffodil
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=daffodil
MINIO_SECRET_KEY=CHANGE_ME_strong_minio_password

# --- Qdrant (vector memory) --------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333
EMBEDDING_MODEL=text-embedding-3-small
MEMORY_QDRANT_COLLECTION=daffodil_memory
MEMORY_SEMANTIC_ENABLED=true

# --- Public URLs (HTTPS in production) ---------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_URL=https://api.your-domain.com
FRONTEND_PUBLIC_URL=https://your-domain.com
CORS_ORIGINS=https://your-domain.com

# --- Frontend build-time (also set in apps/web/.env.production) --------------
VITE_API_URL=https://api.your-domain.com
VITE_WS_URL=wss://api.your-domain.com

# --- Auth / secrets (generate: openssl rand -hex 32) -------------------------
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
APP_SECRET_KEY=CHANGE_ME_another_openssl_rand_hex_32

# --- AI providers (at least one required) ------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_NAME=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.0-flash
GEMINI_VOICE=Aoede
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_FAST_CHAT=true
HUGGINGFACE_API_KEY=
HUGGINGFACE_ENABLED=false

# --- Web search (optional) ---------------------------------------------------
GOOGLE_SEARCH_API_KEY=
GOOGLE_CSE_ID=
SERPER_API_KEY=
WORKSPACE_ROOT=/var/lib/daffodil/workspace

# --- Google OAuth ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.your-domain.com/api/auth/telegram/google/callback
TELEGRAM_GOOGLE_OAUTH_REDIRECT_URI=https://api.your-domain.com/api/auth/telegram/google/callback

# --- Email (production: use Resend or SMTP) ----------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@your-domain.com
SMTP_USE_SSL=false
SMTP_STARTTLS=true

# --- Telegram (optional) -----------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_CHAT_MODEL=auto
TELEGRAM_OAUTH_PUBLIC_URL=https://api.your-domain.com

# --- MCP / workers -----------------------------------------------------------
MCP_ENABLED=true
MCP_SERVER_PORT=8001
MCP_SERVER_URL=http://mcp:8001
MCP_TRANSPORT=stdio
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Runtime (production) ----------------------------------------------------
NODE_ENV=production
LOG_LEVEL=INFO
USE_MOCK_DATA=false

# --- Computer use (tighten in production) ------------------------------------
COMPUTER_USE_ENABLED=true
COMPUTER_USE_REQUIRE_CONFIRM=true
COMPUTER_USE_SANDBOX=true
SCREEN_CAPTURE_FPS=5
