# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/daffodil

# Redis
REDIS_URL=redis://localhost:6379

# API Keys
OPENAI_API_KEY=sk-xxx
GEMINI_API_KEY=xxx
ANTHROPIC_API_KEY=sk-xxx

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=30

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# MCP Server v2
MCP_SERVER_URL=http://localhost:8001
MCP_AUTH_TOKEN=

# Messaging
TELEGRAM_BOT_TOKEN=xxx
TELEGRAM_ENABLED=false
TELEGRAM_ALLOWED_USER_IDS=
API_PUBLIC_URL=http://localhost:8000

# Google OAuth (Telegram "Login with Google" + web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email OTP for Telegram registration (optional; without SMTP, code is shown in bot)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@daffodil.edu.bd
WHATSAPP_PHONE_ID=xxx
WHATSAPP_ACCESS_TOKEN=xxx

# Gemini Live
GEMINI_MODEL_NAME=gemini-2.0-flash-exp
GEMINI_VOICE=Aoede

# RAG
QDRANT_URL=http://localhost:6333
EMBEDDING_MODEL=text-embedding-3-small

# Environment
NODE_ENV=development
LOG_LEVEL=DEBUG

# === NEW: Computer Use ===
COMPUTER_USE_ENABLED=true
SCREEN_CAPTURE_FPS=5
AGENT_CURSOR_VISIBLE=true
COMPUTER_USE_SANDBOX=false

# === NEW: Celery Workers ===
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# === NEW: Security ===
COMPUTER_USE_ALLOWED_DOMAINS=*
COMPUTER_USE_REQUIRE_CONFIRM=true

# === NEW: Antigravity Agent Runtime ===
ANTIGRAVITY_MODEL=gemini-2.0-flash
ANTIGRAVITY_SAVE_DIR=conversations
ANTIGRAVITY_ENABLE_SUBAGENTS=true

# === NEW: MCP ===
MCP_ENABLED=true
MCP_SERVER_PORT=8001
MCP_TRANSPORT=stdio
MCP_EXTERNAL_SERVERS=

# === NEW: Memory ===
MEMORY_QDRANT_COLLECTION=daffodil_memory
MEMORY_SEMANTIC_ENABLED=true