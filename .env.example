# =============================================================================
# Daffodil Intelligence — local development environment
# Copy to `.env` in this directory:  cp .env.example .env
# Docker Compose reads this file automatically.
# For the API running on the host, copy relevant values to `apps/api/.env`.
# =============================================================================

# --- PostgreSQL (docker service: postgres) -----------------------------------
POSTGRES_USER=daffodil
POSTGRES_PASSWORD=daffodil
POSTGRES_DB=daffodil
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Used by API / tools on the host machine
DATABASE_URL=postgresql://daffodil:daffodil@localhost:5432/daffodil

# Adminer UI: http://localhost:8080
#   System: PostgreSQL
#   Server: postgres  (inside Docker)  |  localhost  (from host)
#   Username / Password / Database: use POSTGRES_* values above

# --- Redis (docker service: redis) -------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- MinIO (docker service: minio) -------------------------------------------
MINIO_ROOT_USER=daffodil
MINIO_ROOT_PASSWORD=daffodil123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_URL=http://localhost:9001
MINIO_BUCKET=daffodil
MINIO_USE_SSL=false

# API client keys (same as root user/password in dev)
MINIO_ACCESS_KEY=daffodil
MINIO_SECRET_KEY=daffodil123

# MinIO console: http://localhost:9001  (login: MINIO_ROOT_USER / MINIO_ROOT_PASSWORD)

# --- Adminer -----------------------------------------------------------------
ADMINER_PORT=8080

# --- Qdrant (docker service: qdrant) -----------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
EMBEDDING_MODEL=text-embedding-3-small
MEMORY_QDRANT_COLLECTION=daffodil_memory
MEMORY_SEMANTIC_ENABLED=true

# --- API ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Frontend ----------------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# --- Auth / JWT --------------------------------------------------------------
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=30
APP_SECRET_KEY=your-super-secret-key-change-in-production

# --- AI providers ------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_NAME=gpt-4-turbo-preview
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_MODEL_NAME=gemini-2.0-flash-exp
GEMINI_VOICE=Aoede
ANTIGRAVITY_MODEL=gemini-2.0-flash
ANTIGRAVITY_SAVE_DIR=conversations
ANTIGRAVITY_ENABLE_SUBAGENTS=true
ANTIGRAVITY_DISABLE_BUILTIN_OVERLAPS=true

# --- Web search / research ---------------------------------------------------
# Google Custom Search (https://developers.google.com/custom-search)
GOOGLE_SEARCH_API_KEY=
GOOGLE_CSE_ID=
# Serper.dev Google search API (optional alternative)
SERPER_API_KEY=
# Sandbox root for shell/file tools (empty = process cwd)
WORKSPACE_ROOT=

# --- Hugging Face (GLM-5.1 via Inference API) --------------------------------
HUGGINGFACE_API_KEY=
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
HUGGINGFACE_MODEL=zai-org/GLM-5.1
HUGGINGFACE_ENABLED=true

# --- Google OAuth ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google OAuth — add in Google Cloud authorized redirect URIs (web + Telegram)
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/telegram/google/callback
TELEGRAM_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/telegram/google/callback

# --- Telegram ----------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# Telegram user ids allowed to run /shell (comma-separated; empty = nobody)
TELEGRAM_ADMIN_USER_IDS=
# Fast model for Telegram chat; set to "auto" for the model router
TELEGRAM_CHAT_MODEL=gemini-2.0-flash-lite
# Public HTTPS URL for Telegram Google buttons (e.g. ngrok). Required for one-tap OAuth on mobile.
TELEGRAM_OAUTH_PUBLIC_URL=

# --- Email OTP (web + Telegram registration) ----------------------------------
# Provider: auto (pick Resend if key set, else SMTP), smtp, resend, or none
EMAIL_PROVIDER=auto
# Local dev: run `docker compose up mailpit -d` then open http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@daffodil.local
SMTP_USE_SSL=false
SMTP_STARTTLS=false
# Production alternative: https://resend.com
RESEND_API_KEY=
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Messaging (optional) ----------------------------------------------------
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=

# --- MCP ---------------------------------------------------------------------
MCP_ENABLED=true
MCP_SERVER_PORT=8001
MCP_SERVER_URL=http://localhost:8001
MCP_TRANSPORT=stdio
MCP_AUTH_TOKEN=
MCP_EXTERNAL_SERVERS=

# --- Workers / Celery --------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Computer use ------------------------------------------------------------
COMPUTER_USE_ENABLED=true
COMPUTER_USE_REQUIRE_CONFIRM=true
COMPUTER_USE_SANDBOX=false
COMPUTER_USE_ALLOWED_DOMAINS=*
SCREEN_CAPTURE_FPS=5
AGENT_CURSOR_VISIBLE=true

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=WARNING
USE_MOCK_DATA=true
