#!/bin/sh
# CopyCat — curl -fsSL https://raw.githubusercontent.com/the-shoaib2/daffodil-intelligence/main/install | sh
set -e
R=${DAFFODIL_KIT_REPO:-the-shoaib2/daffodil-intelligence}
V=${DAFFODIL_KIT_VERSION:-main}
D=$(dirname "$0")
B="$D/packages/daffodil-kit/scripts/bootstrap-python.sh"
[ -f "$B" ] || { B=$(mktemp); curl -fsSL "https://raw.githubusercontent.com/$R/$V/packages/daffodil-kit/scripts/bootstrap-python.sh" -o "$B"; trap 'rm -f "$B"' EXIT; }
# shellcheck source=/dev/null
. "$B"
copycat_ensure_python || exit 1
if [ -f "$D/packages/daffodil-kit/install.py" ]; then
  copycat_run_python "$D/packages/daffodil-kit/install.py"
else
  U="https://raw.githubusercontent.com/$R/$V/packages/daffodil-kit/install.py"
  curl -fsSL "$U" | copycat_run_python -
fi
